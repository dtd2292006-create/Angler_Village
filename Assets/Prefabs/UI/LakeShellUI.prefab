--- !u!114 &1146
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1143}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.972549, g: 0.9372549, b: 0.84313726, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 26
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.15
  m_Text: "A / D ho\u1EB7c ph\xEDm m\u0169i t\xEAn: di chuy\u1EC3n. \u0110i v\xE0o
    \u0111i\u1EC3m c\xE2u \u0111\u1EC3 chu\u1EA9n b\u1ECB.\nGi\u1EEF chu\u1ED9t tr\xE1i
    l\u1EA5y \u0111\xE0; th\u1EA3 \u0111\u1EC3 qu\u0103ng. Gi\u1EEF l\xE2u h\u01A1n
    \u0111\u1EC3 qu\u0103ng m\u1EA1nh h\u01A1n.\nD\u01B0\u1EDBi n\u01B0\u1EDBc: gi\u1EEF
    chu\u1ED9t \u0111\u1EC3 thu, nh\u1EA3 \u0111\u1EC3 m\u1ED3i ch\xECm l\u1EA1i
    trong gi\u1EDBi h\u1EA1n d\xE2y.\nQTE: nh\u1EA5p khi kim v\xE0o v\xF9ng tr\u1EAFng
    (Good) ho\u1EB7c xanh (Great).\nTh\u1EA5t b\u1EA1i QTE s\u1EBD t\u1EA1m kh\xF3a
    thu d\xE2y; kh\xE1ng c\u1EF1 qu\xE1 cao l\xE2u s\u1EBD \u0111\u1EE9t d\xE2y.\nC\xE1
    v\u1EC1 \u0111\u1EA7u c\u1EA7n \u0111\u01B0\u1EE3c c\u1EA5t v\xE0o t\xFAi. I
    m\u1EDF t\xFAi; ch\u1ECDn c\xE1 \u0111\u1EC3 xem th\xF4ng tin.\n\u0110i v\u1EC1
    ph\xEDa b\u1EDD \u0111\u1EC3 r\u1EDDi \u0111i\u1EC3m c\xE2u khi \u0111\xE3 thu
    m\u1ED3i v\xE0 k\u1EBFt th\xFAc \u0111\u1ED9ng t\xE1c.\nEsc t\u1EA1m d\u1EEBng.
    Ti\u1EBFn tr\xECnh \u0111\u01B0\u1EE3c l\u01B0u t\u1EF1 \u0111\u1ED9ng."
